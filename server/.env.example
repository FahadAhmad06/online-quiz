# Copy to .env for local dev. On Vercel, set these in Project Settings -> Environment Variables
# instead of uploading a file - Vercel does not read .env files from the repo.

PORT=5000
MONGO_URI=mongodb://localhost:27017/quizroom
JWT_SECRET=replace-with-a-long-random-string
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-a-strong-password
# The deployed client's origin (e.g. https://your-client.vercel.app). Used for CORS.
CLIENT_ORIGIN=http://localhost:5173
