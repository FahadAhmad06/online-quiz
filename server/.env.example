# Copy to .env for local dev. On Vercel, set these in Project Settings -> Environment Variables
# instead of uploading a file - Vercel does not read .env files from the repo.

PORT=5000
MONGO_URI=mongodb://localhost:27017/quizroom
JWT_SECRET=replace-with-a-long-random-string
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-a-strong-password
# The deployed client's origin (e.g. https://your-client.vercel.app). Used for CORS.
CLIENT_ORIGIN=http://localhost:5173

# Optional - only needed for AI-assisted subjective-answer grading. Without it the server still
# runs fine; subjective submissions just sit as "failed" until an admin manually reviews them.
#
# Gemini is tried first. If it is temporarily unavailable (quota exhausted, rate limited, a 5xx,
# a timeout, or an unusable response) Groq is tried next, automatically - no manual switching.
# Neither provider is ever retried through an invalid/expired API key; that always needs an admin
# to fix the key. Test each key independently with npm run check:ai / npm run check:groq.
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_ENABLED=true

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional AI grading tuning - all have safe defaults; leave unset unless you need to change them.
# Per-call timeout, shared by both providers.
AI_TIMEOUT_MS=30000
# Attempts on ONE provider (with backoff between them) before moving to the other provider. Keep
# this low so a struggling provider is failed over away from quickly.
AI_MAX_ATTEMPTS_PER_PROVIDER=1
# How long a provider that just failed is skipped for before being tried again, honoring its own
# Retry-After when it gives one. Doubles per consecutive failure on that provider, capped at
# AI_RETRY_MAX_DELAY_MS. Gemini and Groq are tracked - and back off - independently.
AI_RETRY_BASE_DELAY_MS=5000
AI_RETRY_MAX_DELAY_MS=300000

# Max AI grading calls in flight per server process (both providers combined), shared by all
# submissions. Max calls started per minute per provider - set it just under each key's RPM quota
# to avoid 429 "rate limit" failures. 0 = no pacing.
EVAL_CONCURRENCY=4
EVAL_RPM=0
# Grading runs per answer (automatic sweeps + student retries) before only an admin can retry it.
EVAL_MAX_RUNS=3
# Background sweep interval (ms) on a long-running server (npm start); 0 disables. Not used on Vercel.
EVAL_SWEEP_INTERVAL_MS=60000
# Optional: MINIMAL | LOW | MEDIUM | HIGH. Unset keeps the model's default thinking. Lower levels
# are usually faster but can change grading quality - compare on real answers before enabling.
GEMINI_THINKING_LEVEL=
